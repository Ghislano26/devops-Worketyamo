# Vagrantfile — environnement de formation Rocky Linux 9 (VM « devops-lab »), construit par chaque étudiant.
# Usage : cd environnement && make up      (ou : cd environnement/vagrant && vagrant up)
# Voir GUIDE-ENVIRONNEMENT.md à la racine du dépôt.
Vagrant.configure("2") do |config|
  # Box publique officielle Rocky Linux 9, épinglée à une version mineure
  config.vm.box = "rockylinux/9"
  config.vm.box_version = "~> 9.4"
  config.vm.box_check_update = false
  config.vm.hostname = "devops-lab"

  # Réseau « host-only » : la VM est joignable depuis l'hôte à 192.168.56.10 (en plus du NAT).
  config.vm.network "private_network", ip: "192.168.56.10"

  # /vagrant = RACINE DU DÉPÔT (deux niveaux au-dessus de ce fichier), pas le dossier personnel.
  config.vm.synced_folder "../..", "/vagrant", type: "virtualbox"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "4096"
    vb.cpus = 2
    vb.name = "devops-lab"
  end

  # Si la box n'embarque pas les Guest Additions (dossier /vagrant vide ou erreur « vboxsf »),
  # installer le plugin :  vagrant plugin install vagrant-vbguest   (voir GUIDE-ENVIRONNEMENT.md, § 10)
  if Vagrant.has_plugin?("vagrant-vbguest")
    config.vbguest.auto_update = true
  end

  # Provisioning automatique : les 3 scripts, dans l'ordre (nommés pour pouvoir être relancés un à un :
  # vagrant provision --provision-with 02-devops-tools)
  config.vm.provision "shell", name: "01-base",          path: "../scripts/01-base.sh"
  config.vm.provision "shell", name: "02-devops-tools",  path: "../scripts/02-devops-tools.sh"
  config.vm.provision "shell", name: "03-hardening",     path: "../scripts/03-hardening.sh"

  # Vérification finale
  config.vm.provision "shell", name: "verification", inline: <<-SHELL
    echo "Vérification des outils DevOps..."
    for tool in kubectl helm trivy syft act shellcheck podman git yq; do
      if ! command -v $tool &> /dev/null; then
        echo "ERREUR : $tool non installé"; exit 1
      fi
    done
    echo "Environnement prêt. Utilisez 'vagrant ssh' pour vous connecter."
  SHELL
end
